{
  "name": "prompt-vault",
  "productName": "Prompt Vault",
  "version": "1.2.0",
  "description": "Library and randomizer for AI image prompts: characters, poses, LoRAs.",
  "main": "electron/main.js",
  "author": "TheBigVoid",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "io.github.thebigvoid.promptvault",
    "productName": "Prompt Vault",
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "electron/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prompt Vault",
      "artifactName": "PromptVault-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
