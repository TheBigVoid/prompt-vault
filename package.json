{
  "name": "prompt-vault",
  "productName": "Prompt Vault",
  "version": "2.2.0",
  "description": "Library and randomizer for AI image prompts: characters, poses, LoRAs.",
  "main": "electron/main.js",
  "author": "TheBigVoid",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "node scripts/release.js"
  },
  "build": {
    "appId": "io.github.thebigvoid.promptvault",
    "productName": "Prompt Vault",
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "electron/**",
      "build/icon.png",
      "fonts/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prompt Vault",
      "artifactName": "PromptVault-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "TheBigVoid",
      "repo": "prompt-vault",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
